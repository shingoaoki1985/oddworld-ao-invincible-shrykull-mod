+constexpr size_t kJapaneseAtlasEntryCount = 238;
+std::array<Font_AtlasEntry, kJapaneseAtlasEntryCount> sJapaneseFont1Atlas = {};
+std::array<Font_AtlasEntry, kJapaneseAtlasEntryCount> sJapaneseFont2Atlas = {};
+
+bool LoadJapaneseFontAtlases()
+{
+    static bool attempted = false;
+    static bool loaded = false;
+    if (attempted)
+    {
+        return loaded;
+    }
+    attempted = true;
+
+#if _WIN32
+    char_type modulePath[MAX_PATH] = {};
+    if (!::GetModuleFileNameA(nullptr, modulePath, MAX_PATH))
+    {
+        return false;
+    }
+
+    std::string atlasPath = modulePath;
+    const auto separator = atlasPath.find_last_of("\\/");
+    if (separator == std::string::npos)
+    {
+        return false;
+    }
+    atlasPath.resize(separator + 1);
+    atlasPath += "japanese_font_atlas.bin";
+
+    FILE* file = ::fopen(atlasPath.c_str(), "rb");
+    if (!file)
+    {
+        LOG_WARNING("Japanese font atlas was not found at " << atlasPath);
+        return false;
+    }
+
+    const bool readFont1 = ::fread(sJapaneseFont1Atlas.data(), sizeof(Font_AtlasEntry), sJapaneseFont1Atlas.size(), file) == sJapaneseFont1Atlas.size();
+    const bool readFont2 = ::fread(sJapaneseFont2Atlas.data(), sizeof(Font_AtlasEntry), sJapaneseFont2Atlas.size(), file) == sJapaneseFont2Atlas.size();
+    const bool exactSize = ::fgetc(file) == EOF;
+    ::fclose(file);
+    loaded = readFont1 && readFont2 && exactSize;
+    if (loaded)
+    {
+        LOG_INFO("Loaded Japanese Oddysee font atlases from " << atlasPath);
+    }
+    else
+    {
+        LOG_WARNING("Japanese font atlas has an invalid size: " << atlasPath);
+    }
+#endif
+    return loaded;
+}
+
+bool IsJapaneseAtlas(const FontContext* context)
+{
+    return context->field_8_atlas_array == sJapaneseFont1Atlas.data()
+           || context->field_8_atlas_array == sJapaneseFont2Atlas.data();
+}
+
+bool IsPlainAsciiText(const char_type* text)
+{
+    for (const u8* ptr = reinterpret_cast<const u8*>(text); *ptr; ++ptr)
+    {
+        if (*ptr >= 128)
+        {
+            return false;
+        }
+    }
+    return true;
+}
+
+s32 JapaneseAtlasIndex(u8 character, bool plainAsciiText)
+{
+    if (character == ' ' || character < 8)
+    {
+        return 1;
+    }
+
+    if (plainAsciiText)
+    {
+        if (character >= '0' && character <= '9')
+        {
+            return 15 + character - '0';
+        }
+        if (character >= 'A' && character <= 'Z')
+        {
+            return 212 + character - 'A';
+        }
+        if (character >= 'a' && character <= 'z')
+        {
+            return 212 + character - 'a';
+        }
+        // The Japanese atlas has no general ASCII punctuation set. Keeping its
+        // spacing makes hard-coded R.E.L.I.V.E. English labels readable.
+        return 1;
+    }
+
+    if (character >= 8 && character <= 20)
+    {
+        return character - 6;
+    }
+    if (character <= 32)
+    {
+        return 1;
+    }
+
+    const s32 index = character - 31;
+    return index < static_cast<s32>(kJapaneseAtlasEntryCount) ? index : 1;
+}
+
+s32 AtlasIndex(const FontContext* context, u8 character, bool plainAsciiText)
+{
+    if (IsJapaneseAtlas(context))
+    {
+        return JapaneseAtlasIndex(character, plainAsciiText);
+    }
+
+    if (character <= 32 || character > 175)
+    {
+        return character >= 8 && character <= 31 ? character + 84 : 1;
+    }
+    return character - 31;
+}
